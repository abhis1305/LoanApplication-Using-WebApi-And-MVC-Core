  "components": {
    "schemas": {
      "AddMoneyDTO": {
        "required": [
          "customerId"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CibilReport": {
        "type": "object",
        "properties": {
          "cibilReportId": {
            "type": "integer",
            "format": "int32"
          },
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "panNo": {
            "type": "string",
            "nullable": true
          },
          "cibilScore": {
            "type": "integer",
            "format": "int32"
          },
          "checkDate": {
            "type": "string",
            "format": "date-time"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          }
        },
        "additionalProperties": false
      },
      "CibilScoreRequestDto": {
        "type": "object",
        "properties": {
          "customerId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateTicketDTO": {
        "required": [
          "customerId",
          "description",
          "loanAccountId",
          "subject"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "loanAccountId": {
            "type": "integer",
            "format": "int32"
          },
          "subject": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "attachmentPath": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Customer": {
        "required": [
          "aadhaarNo",
          "age",
          "email",
          "employmentType",
          "firstName",
          "lastName",
          "mobileNo",
          "monthlyIncome",
          "pan",
          "password"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "minLength": 1,
            "pattern": "^[A-Za-z]{2,12}$",
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "pattern": "^[A-Za-z]{2,12}$",
            "type": "string"
          },
          "age": {
            "maximum": 60,
            "minimum": 18,
            "type": "integer",
            "format": "int32"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "mobileNo": {
            "minLength": 1,
            "pattern": "^[6-9]\\d{9}$",
            "type": "string"
          },
          "pan": {
            "minLength": 1,
            "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
            "type": "string"
          },
          "aadhaarNo": {
            "minLength": 1,
            "pattern": "^[0-9]{12}$",
            "type": "string"
          },
          "employmentType": {
            "minLength": 1,
            "type": "string"
          },
          "monthlyIncome": {
            "maximum": 10000000,
            "minimum": 1000,
            "type": "number",
            "format": "double"
          },
          "monthlyInvestement": {
            "type": "number",
            "format": "double"
          },
          "isEmailVerified": {
            "type": "boolean"
          },
          "kycDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KycDocument"
            },
            "nullable": true
          },
          "cibilReports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CibilReport"
            },
            "nullable": true
          },
          "eligibilityResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EligibilityResult"
            },
            "nullable": true
          },
          "scoreCards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoreCard"
            },
            "nullable": true
          },
          "loanDeals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoanDeal"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DealReview": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "integer",
            "format": "int32"
          },
          "dealId": {
            "type": "integer",
            "format": "int32"
          },
          "officerId": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "loanDeal": {
            "$ref": "#/components/schemas/LoanDeal"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "Disbursement": {
        "type": "object",
