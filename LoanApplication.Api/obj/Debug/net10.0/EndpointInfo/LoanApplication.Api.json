            "type": "integer",
            "format": "int32"
          },
          "dealId": {
            "type": "integer",
            "format": "int32"
          },
          "disburseAmount": {
            "type": "number",
            "format": "double"
          },
          "bankPartner": {
            "type": "string",
            "nullable": true
          },
          "disbursementDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "loanDeal": {
            "$ref": "#/components/schemas/LoanDeal"
          }
        },
        "additionalProperties": false
      },
      "EligibilityRequestDto": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          }
        },
